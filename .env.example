# ============================================================
# TXEKA NTIYISO - Variáveis de Ambiente
# Plataforma de Validação Digital de Documentos - Moçambique
# Conformidade: Decreto 59/2019, Lei 3/2017
# Fuso horário: CAT (UTC+2)
# ============================================================

# -------- Ambiente e Debug --------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -------- Servidor --------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# -------- Fuso Horário (Decreto 59/2019) --------
TZ=Africa/Maputo
LANG=pt_MZ.UTF-8
LC_ALL=pt_MZ.UTF-8

# -------- Segurança - CORS --------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://txeka-ntiyiso-api.onrender.com

# -------- Segurança - JWT --------
# MUDAR EM PRODUÇÃO! Gerar com: openssl rand -hex 32
SECRET_KEY=TXEKA-NTIYISO-2026-k3ab9sGze6Igc1u8Q5@i+j0#0KX0rBzj
JWT_SECRET_KEY=TXEKA-NTIYISO-2026-k3ab9sGze6Igc1u8Q5@i+j0#0KX0rBzj
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------- Autenticação --------
# false = obrigatório JWT em todos os endpoints protegidos
ALLOW_ANONYMOUS=false

# -------- Rate Limiting --------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# -------- Gestão de Ficheiros --------
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/tmp/docverify_uploads

# -------- Base de Dados --------
# Local (dev): sqlite:///./docverify.db
# Produção (Render): postgresql://user:pass@host:port/db
DATABASE_URL=sqlite:///./docverify.db

# -------- OCR (Tesseract) - Futuro --------
TESSERACT_PATH=/usr/bin/tesseract

# -------- Integrações de Pagamento - M-Pesa --------
MPESA_API_KEY=your-mpesa-api-key-here
MPESA_API_URL=https://api.sandbox.mtn.co.mz

# -------- Integrações de Pagamento - e-Mola --------
EMOLA_API_KEY=your-emola-api-key-here
EMOLA_API_URL=https://api.emola.co.mz

# -------- Email (SMTP) --------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@txeka.co.mz

# -------- Render Deployment --------
RENDER_API_KEY=your-render-api-key-here

# -------- URLs --------
BASE_URL=http://localhost:8000
