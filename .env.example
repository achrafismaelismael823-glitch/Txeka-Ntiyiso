# ============================================================
# TXEKA NTIYISO - Variaveis de Ambiente
# Plataforma de Validacao Digital de Documentos - Mocambique
# Conformidade: Decreto 59/2019, Lei 3/2017
# Fuso horario: CAT (UTC+2)
# ============================================================
# NUNCA commitar valores reais. Copie para .env e preencha.

# -------- Ambiente e Debug --------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# -------- Servidor --------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# -------- Fuso Horario (Decreto 59/2019) --------
TZ=Africa/Maputo
LANG=pt_MZ.UTF-8
LC_ALL=pt_MZ.UTF-8

# -------- Seguranca - CORS --------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -------- Seguranca - JWT --------
# Gerar com: openssl rand -hex 32
SECRET_KEY=
JWT_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -------- Autenticacao --------
ALLOW_ANONYMOUS=false

# -------- Rate Limiting --------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# -------- Gestao de Ficheiros --------
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/tmp/docverify_uploads

# -------- Base de Dados --------
# Local (dev): sqlite:///./docverify.db
# Producao (Render): postgresql://user:pass@host:port/db
DATABASE_URL=

# -------- OCR (Tesseract) - Futuro --------
TESSERACT_PATH=/usr/bin/tesseract

# -------- Integracoes de Pagamento - M-Pesa --------
MPESA_API_KEY=
MPESA_API_URL=https://api.sandbox.mtn.co.mz

# -------- Integracoes de Pagamento - e-Mola --------
EMOLA_API_KEY=
EMOLA_API_URL=https://api.emola.co.mz

# -------- Email (SMTP) --------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@txeka.co.mz

# -------- Render Deployment --------
RENDER_API_KEY=

# -------- URLs --------
BASE_URL=http://localhost:8000
