# .env.example - DocVerify MZ
# Copie este ficheiro para .env e preencha com valores reais
# NUNCA commita o ficheiro .env com valores sensíveis

# Ambiente e Debug
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Configuração de Servidor
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Segurança - CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Segurança - Chaves e Tokens
SECRET_KEY=change-me-in-production-use-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Taxa de Requisições
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# Gestão de Ficheiros
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=/tmp/docverify_uploads

# Base de Dados
DATABASE_URL=sqlite:///./docverify.db

# OCR (Tesseract) - Opcional para futuro
TESSERACT_PATH=/usr/bin/tesseract

# Integrações de Pagamento - M-Pesa
MPESA_API_KEY=your-mpesa-api-key-here
MPESA_API_URL=https://api.sandbox.mtn.co.mz

# Integrações de Pagamento - e-Mola
EMOLA_API_KEY=your-emola-api-key-here
EMOLA_API_URL=https://api.emola.co.mz

# Email (SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@docverify.mz

# Render Deployment
RENDER_API_KEY=your-render-api-key-here
