# ============================================
# TXEKA NTIYISO — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env real!
#
# 🚀 Para Render.com: cole os valores em Environment Variables do dashboard

# ─── OBRIGATÓRIAS (a aplicação falha se não estiverem configuradas) ───

# Chave secreta para hashing/HMAC (mínimo 32 caracteres, hex recomendado)
# Gere com: openssl rand -hex 32
SECRET_KEY=

# Chave secreta para JWT (DEVE ser diferente de SECRET_KEY)
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=

# URL do banco de dados PostgreSQL
# Render: use a "Internal Database URL" do PostgreSQL managed
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/txeka_ntiyiso
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/txeka_ntiyiso

# ─── OPICIONAIS (possuem valores padrão seguros) ───

# Ambiente: development | staging | production
ENVIRONMENT=development

# Permitir acesso anônimo (true/false)
TXEKA_ALLOW_ANONYMOUS=false

# CORS — origens permitidas (separadas por vírgula)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limits
RATE_LIMIT_GLOBAL=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_CERTIFY=10/minute

# Admin do sistema
ADMIN_EMAIL=admin@txeka.co.mz
ADMIN_PASSWORD_HASH=

# Email / Notificações (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@txeka.co.mz

# Redis (cache e filas)
# Render: use a "Internal Redis URL" do Redis managed
# Local: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 / S3 (storage de QR codes e PDFs)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=txeka-documents

# Observabilidade
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
